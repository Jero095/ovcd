# Entornos y caches
.venv/
__pycache__/
*.pyc

# Pesos y datos grandes (no versionar)
weights/
*.pth
hyperglobal/imgs/
hyperglobal_sample/

# Repos vendoreados (tienen su propia historia)
HyperSIGMA/
HyperCap/

# Salidas y material de referencia
*.png
# Excepción: figuras del plan (assets del LaTeX, deben versionarse)
!Template___Plan_TrabajoGrado/figuras/*.png
papers/

# Artefactos de build de LaTeX
*.aux
*.log
*_build.log

# Archivos temporales / de bloqueo de Office
~$*
~WRL*.tmp
# Excepcion: figuras y logo del libro de trabajo de grado
!docs/libro/figuras/*.png
!docs/libro/logo_uis.png
